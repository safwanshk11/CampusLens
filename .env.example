# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string. Neon is the intended host; use its *pooled*
# connection string for serverless deployments on Vercel.
# Required for database commands; the Phase 0 UI still builds without it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional direct PostgreSQL URL for CLI migrations and seed (Neon unpooled URL).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public origin used for canonical URLs and Open Graph metadata.
# Optional: falls back to VERCEL_URL on Vercel, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
